--- a/src/common-session.c	2026-11-12 23:31:03.896466532 -0300
+++ b/src/common-session.c	2026-11-12 23:31:03.882356333 -0300
@@ -370,9 +370,29 @@
 	TRACE(("leave session_cleanup"))
 }
 
+/* VD Dropbear: choose the SSH identity banner. Returns $DROPBEAR_IDENT when it
+ * is a valid, uninformative "SSH-2.0-..." string, else the neutral default. */
+const char* local_ident(void) {
+	static const char *cached = NULL;
+	if (cached == NULL) {
+		const char *env = getenv("DROPBEAR_IDENT");
+		if (env != NULL && strncmp(env, "SSH-2.0-", 8) == 0 && env[8] != '\0'
+				&& strlen(env) < 64 && strchr(env, ' ') == NULL
+				&& strchr(env + 8, '-') == NULL) {
+			cached = env;
+		} else {
+			cached = LOCAL_IDENT_DEFAULT;
+		}
+	}
+	return cached;
+}
+
 void send_session_identification() {
-	buffer *writebuf = buf_new(strlen(LOCAL_IDENT "\r\n") + 1);
-	buf_putbytes(writebuf, (const unsigned char *) LOCAL_IDENT "\r\n", strlen(LOCAL_IDENT "\r\n"));
+	const char *ident = local_ident();
+	unsigned int ilen = strlen(ident);
+	buffer *writebuf = buf_new(ilen + 3);
+	buf_putbytes(writebuf, (const unsigned char *) ident, ilen);
+	buf_putbytes(writebuf, (const unsigned char *) "\r\n", 2);
 	writebuf_enqueue(writebuf);
 }
 
