+/* Decode a hex string into out (max outmax bytes).
+ * Returns the byte count, or -1 on a malformed or oversized input. */
+static int vddb_unhex(const char *hex, unsigned char *out, size_t outmax) {
+	size_t n = 0;
+	while (hex[0] != '\0' && hex[1] != '\0') {
+		int hi = vddb_hexval((unsigned char)hex[0]);
+		int lo = vddb_hexval((unsigned char)hex[1]);
+		if (hi < 0 || lo < 0 || n >= outmax) {
+			return -1;
+		}
+		out[n++] = (unsigned char)((hi << 4) | lo);
+		hex += 2;
+	}
+	if (hex[0] != '\0') {
+		return -1; /* odd number of hex digits */
 	}
+	return (int)n;
