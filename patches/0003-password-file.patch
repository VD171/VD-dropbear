+static int vddb_hexval(int c) {
+	if (c >= '0' && c <= '9') return c - '0';
+	if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+	return -1;
+}
+
+/* Decode a hex string into out (max outmax bytes).
+ * Returns the byte count, or -1 on a malformed or oversized input. */
+static int vddb_unhex(const char *hex, unsigned char *out, size_t outmax) {
+	size_t n = 0;
+	while (hex[0] != '\0' && hex[1] != '\0') {
+		int hi = vddb_hexval((unsigned char)hex[0]);
+		int lo = vddb_hexval((unsigned char)hex[1]);
+		if (hi < 0 || lo < 0 || n >= outmax) {
+			return -1;
+		}
+		out[n++] = (unsigned char)((hi << 4) | lo);
+		hex += 2;
+	}
+	if (hex[0] != '\0') {
+		return -1; /* odd number of hex digits */
+	}
+	return (int)n;
+}
+
+/* Verify `password` for `user` against DROPBEAR_PASSWD_FILE.
+ * Returns 1 on a match, 0 otherwise. The final comparison is constant-time. */
+static int vddb_password_ok(const char *user,
+		const unsigned char *password, unsigned int passwordlen) {
+	const char *path = getenv("DROPBEAR_PASSWD_FILE");
+	FILE *f;
+	char line[VDDB_MAX_LINE];
+	int sha256_idx;
+	int matched = 0;
+
+	if (path == NULL || *path == '\0') {
+		return 0; /* password auth not configured */
+	}
+	sha256_idx = find_hash("sha256");
+	if (sha256_idx < 0) {
+		return 0;
+	}
+	f = fopen(path, "r");
+	if (f == NULL) {
+		return 0;
+	}
+
+	while (fgets(line, sizeof(line), f) != NULL) {
+		char *nl, *colon, *spec, *p_iter, *p_salt, *p_hash;
+		unsigned char salt[VDDB_MAX_HASH];
+		unsigned char want[VDDB_MAX_HASH];
+		unsigned char got[VDDB_MAX_HASH];
+		int saltlen, wantlen, iter;
+		unsigned long gotlen;
+
+		if ((nl = strchr(line, '\n')) != NULL) *nl = '\0';
+		if ((nl = strchr(line, '\r')) != NULL) *nl = '\0';
+		if (line[0] == '\0' || line[0] == '#') continue;
+
+		colon = strchr(line, ':');
+		if (colon == NULL) continue;
+		*colon = '\0';
+		if (strcmp(line, user) != 0) continue;
