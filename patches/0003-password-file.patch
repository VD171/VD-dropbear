+/* PBKDF2-HMAC-SHA256 for a single 32-byte output block (dkLen == hLen), which is
+ * all the password format uses. Built on libtomcrypt's hmac_memory and the
+ * registered sha256 - both compiled into Dropbear - so it does not need the
+ * (compiled-out) LTC_PKCS_5 module. Returns 0 on success, -1 on error. */
+static int vddb_pbkdf2_sha256(const unsigned char *pw, unsigned long pwlen,
+		const unsigned char *salt, unsigned long saltlen,
+		int iter, unsigned char out[VDDB_DK_LEN]) {
+	int h = find_hash("sha256");
+	unsigned char U[VDDB_DK_LEN], T[VDDB_DK_LEN], *blk;
+	unsigned long ul, blen;
+	int i, j;
+
+	if (h < 0 || iter < 1) return -1;
+	blen = saltlen + 4;
+	blk = (unsigned char *)m_malloc(blen);          /* dropbear m_malloc never returns NULL */
+	memcpy(blk, salt, saltlen);
+	blk[saltlen] = 0; blk[saltlen + 1] = 0;         /* INT(1), big-endian block index */
+	blk[saltlen + 2] = 0; blk[saltlen + 3] = 1;
+	ul = sizeof(U);
+	if (hmac_memory(h, pw, pwlen, blk, blen, U, &ul) != CRYPT_OK) { m_free(blk); return -1; }
+	m_free(blk);
+	memcpy(T, U, VDDB_DK_LEN);
+	for (i = 1; i < iter; i++) {
+		unsigned char Un[VDDB_DK_LEN]; unsigned long nl = sizeof(Un);
+		if (hmac_memory(h, pw, pwlen, U, VDDB_DK_LEN, Un, &nl) != CRYPT_OK) return -1;
+		memcpy(U, Un, VDDB_DK_LEN);
+		for (j = 0; j < VDDB_DK_LEN; j++) T[j] ^= U[j];
+	}
+	memcpy(out, T, VDDB_DK_LEN);
+	return 0;
+}
+
+/* Verify `password` for `user` against DROPBEAR_PASSWD_FILE.
+ * Returns 1 on a match, 0 otherwise. The final comparison is constant-time. */
+static int vddb_password_ok(const char *user,
+		const unsigned char *password, unsigned int passwordlen) {
+	const char *path = getenv("DROPBEAR_PASSWD_FILE");
+	FILE *f;
+	char line[VDDB_MAX_LINE];
+	int matched = 0;
+
+	if (path == NULL || *path == '\0') {
+		return 0; /* password auth not configured */
+	}
+	f = fopen(path, "r");
+	if (f == NULL) {
+		return 0;
+	}
+
+	while (fgets(line, sizeof(line), f) != NULL) {
+		char *nl, *colon, *spec, *p_iter, *p_salt, *p_hash;
+		unsigned char salt[VDDB_MAX_HASH];
+		unsigned char want[VDDB_MAX_HASH];
+		unsigned char got[VDDB_DK_LEN];
+		int saltlen, wantlen, iter;
+
+		if ((nl = strchr(line, '\n')) != NULL) *nl = '\0';
+		if ((nl = strchr(line, '\r')) != NULL) *nl = '\0';
+		if (line[0] == '\0' || line[0] == '#') continue;
+
+		colon = strchr(line, ':');
+		if (colon == NULL) continue;
+		*colon = '\0';
+		if (strcmp(line, user) != 0) continue;
+
+		spec = colon + 1;
+		if (strncmp(spec, "pbkdf2-sha256$", 14) != 0) continue;
+		p_iter = spec + 14;
+		if ((p_salt = strchr(p_iter, '$')) == NULL) continue;
+		*p_salt++ = '\0';
+		if ((p_hash = strchr(p_salt, '$')) == NULL) continue;
+		*p_hash++ = '\0';
+
+		iter = atoi(p_iter);
+		if (iter < 1) continue;
+		saltlen = vddb_unhex(p_salt, salt, sizeof(salt));
+		wantlen = vddb_unhex(p_hash, want, sizeof(want));
+		if (saltlen <= 0 || wantlen != VDDB_DK_LEN) continue;
+
+		if (vddb_pbkdf2_sha256(password, passwordlen, salt, (unsigned long)saltlen,
+				iter, got) == 0
+				&& constant_time_memcmp(got, want, VDDB_DK_LEN) == 0) {
+			matched = 1;
+		}
+		m_burn(got, sizeof(got));
+		if (matched) break;
+	}
+
+	fclose(f);
+	return matched;
 }
 
