+		spec = colon + 1;
+		if (strncmp(spec, "pbkdf2-sha256$", 14) != 0) continue;
+		p_iter = spec + 14;
+		if ((p_salt = strchr(p_iter, '$')) == NULL) continue;
+		*p_salt++ = '\0';
+		if ((p_hash = strchr(p_salt, '$')) == NULL) continue;
+		*p_hash++ = '\0';
+
+		iter = atoi(p_iter);
+		if (iter < 1) continue;
+		saltlen = vddb_unhex(p_salt, salt, sizeof(salt));
+		wantlen = vddb_unhex(p_hash, want, sizeof(want));
+		if (saltlen <= 0 || wantlen <= 0) continue;
+
+		gotlen = (unsigned long)wantlen;
+		if (pkcs_5_alg2(password, passwordlen, salt, (unsigned long)saltlen,
+				iter, sha256_idx, got, &gotlen) == CRYPT_OK
+				&& (int)gotlen == wantlen
+				&& constant_time_memcmp(got, want, (size_t)wantlen) == 0) {
+			matched = 1;
+		}
+		m_burn(got, sizeof(got));
+		if (matched) break;
 	}
 
